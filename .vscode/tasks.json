{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Rebuild and run TodAI after origin fix",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				".vscode/start-preview.ps1"
			],
			"isBackground": true
		},
		{
			"label": "Stop TodAI browser preview",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-NetTCPConnection -LocalPort 3101 -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }"
			],
			"isBackground": false
		}
	]
}