{
  "name": "todai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pree2e": "cross-env NODE_ENV=test BETTER_AUTH_SECRET=cypress-local-test-secret-at-least-32-characters-long DATABASE_URL=file:./data/cypress.db drizzle-kit migrate",
    "e2e": "cross-env NODE_ENV=test NEXT_DIST_DIR=.next-e2e BETTER_AUTH_SECRET=cypress-local-test-secret-at-least-32-characters-long BETTER_AUTH_URL=http://localhost:3100 DATABASE_URL=file:./data/cypress.db start-server-and-test e2e:server http://localhost:3100 e2e:run",
    "e2e:server": "next dev --hostname localhost --port 3100",
    "e2e:run": "cypress run",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "auth:generate": "auth generate --adapter drizzle --dialect sqlite --config src/lib/auth.ts --output src/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@libsql/client": "^0.18.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "^1.7.7",
    "cross-env": "^10.1.0",
    "cypress": "^16.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  }
}
